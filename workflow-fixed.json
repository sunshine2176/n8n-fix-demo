      "parameters": {
        "jsCode": "// Transform upstream order payload for the downstream CRM API.\nconst payload = $input.first().json.body;\n\n// FIX 1 — upstream sends `total` as a string; convert explicitly.\nconst total = Number(payload.total).toFixed(2);\n\n// FIX 2 — map the id from its real location in the payload.\nconst customerId = payload.customer.id;\n\nconst itemCount = payload.items.length;\n\nreturn [\n  {\n    json: {\n      customerId,\n      itemCount,\n      total,\n      status: 'processed'\n    }\n  }\n];"
      },
